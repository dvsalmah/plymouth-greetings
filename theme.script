HELLO_FRAMES = 300;
GOODBYE_FRAMES = 300;
BOX_SCALE = 0.30;
BOX_WIDTH = Window.GetWidth() * BOX_SCALE;
BOX_HEIGHT = Window.GetHeight() * BOX_SCALE;

HELLO_STEP = 1.0;
GOODBYE_STEP = 1.0;

anim_frames = [];
sprite = Sprite();
frame_index = 1;
last_frame = -1;
target_w = 0;

if (Plymouth.GetMode() == "boot") {
    image_prefix = "hello-";
    frame_count = HELLO_FRAMES;
    anim_step = HELLO_STEP;
} else {
    image_prefix = "goodbye-";
    frame_count = GOODBYE_FRAMES;
    anim_step = GOODBYE_STEP;
}

for (i = 1; i <= frame_count; i++) {
    img = Image(image_prefix + i + ".png");
    if (img == null) continue;

    if (target_w == 0) {
        img_ratio = img.GetWidth() / img.GetHeight();
        box_ratio = BOX_WIDTH / BOX_HEIGHT;

        if (box_ratio > img_ratio) {
            target_h = BOX_HEIGHT;
            target_w = target_h * img_ratio;
        } else {
            target_w = BOX_WIDTH;
            target_h = target_w / img_ratio;
        }
        sprite.SetPosition((Window.GetWidth() - target_w) / 2,
                           (Window.GetHeight() - target_h) / 2, 0);
    }
    anim_frames[i] = img.Scale(target_w, target_h);
}

if (anim_frames[1] != null) {
    sprite.SetImage(anim_frames[1]);
    last_frame = 1;
}

fun refresh_callback () {
    frame_index += anim_step;
    if (frame_index > frame_count) {
        frame_index = frame_index - frame_count;
    }

    frame = Math.Int(frame_index);
    if (frame != last_frame && anim_frames[frame] != null) {
        sprite.SetImage(anim_frames[frame]);
        last_frame = frame;
    }
}

Plymouth.SetRefreshFunction(refresh_callback);
